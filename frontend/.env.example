# ==============================================================================
# Atelier General POS - Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as per your local/production setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Backend Endpoints
# ------------------------------------------------------------------------------
# In local development: pointing to Express backend on port 10000
VITE_API_URL=http://localhost:10000/api/v1

# In production behind Nginx/Vercel proxy:
# VITE_API_URL=/api/v1

# Backend root URL used for serving static assets and employee selfie uploads
VITE_BACKEND_URL=http://localhost:10000

# ------------------------------------------------------------------------------
# 2. Local Thermal Receipt & KOT Printing Service
# Default local print bridge server running on localhost port 9123
# ------------------------------------------------------------------------------
VITE_LOCAL_PRINT_URL=http://127.0.0.1:9123

# ------------------------------------------------------------------------------
# 3. Development Server Port
# ------------------------------------------------------------------------------
PORT=5173

# ------------------------------------------------------------------------------
# 4. Feature Flag Modules (Enable / Disable Sub-modules)
# ------------------------------------------------------------------------------
VITE_INCLUDE_IMS=true
VITE_INCLUDE_HRMS=true
VITE_INCLUDE_HMS=true
